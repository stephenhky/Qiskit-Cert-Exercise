    }
   ],
   "source": [
    "twoqubitsys = QuantumCircuit(2)\n",
    "twoqubitsys.x(0)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 11,
   "id": "85e3e27e",
   "metadata": {},
   "outputs": [],
   "source": [
    "sv = Statevector.from_label('00')\n",
    "sv_ev1 = sv.evolve(twoqubitsys)"
   ]
  },
