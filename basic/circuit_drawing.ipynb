   "source": [
    "q = QuantumRegister(1)\n",
    "qc = QuantumCircuit(q)\n",
    "qc.x(q[0])\n",
    "qc.h(q[0])\n",
    "style = {'backgroundcolor': 'lightgreen'}\n",
    "qc.draw(output='mpl', style=style, scale=3.5, plot_barriers=False, reverse_bits=False)"
